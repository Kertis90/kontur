# Host development: see docs/DEVELOPMENT.md. Copy to .env, then replace secrets.
# Infrastructure: compose.yaml + compose.dev.yaml, project kontur-dev.
DB_ENGINE=mysql
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=kontur_work
POSTGRES_USER=kontur
POSTGRES_PASSWORD=replace-with-a-separate-strong-password
POSTGRES_ADMIN_PASSWORD=replace-with-another-postgres-admin-password
POSTGRES_POOL_SIZE=12
POSTGRES_CONNECT_TIMEOUT=10000
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=kontur_work
MYSQL_USER=kontur
MYSQL_PASSWORD=replace-with-strong-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-password
MYSQL_POOL_SIZE=12
MYSQL_CONNECT_TIMEOUT=10000
MYSQL_SSL=false

AUTH_SECRET=replace-with-at-least-32-random-characters
APP_ENCRYPTION_KEY=replace-with-64-hex-characters
APP_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.ru
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_NAME=Администратор

REDIS_URL=redis://127.0.0.1:6379
AI_WORKER_CONCURRENCY=2
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=kontur-minio
S3_SECRET_KEY=replace-with-strong-minio-secret
S3_BUCKET=kontur-attachments
S3_FORCE_PATH_STYLE=true
MAX_ATTACHMENT_BYTES=26214400
# Keep the MinIO console local too (Compose inserts :9001 after this value).
MINIO_CONSOLE_PORT=127.0.0.1:9001
# При необходимости используйте те же MINIO_IMAGE / MINIO_CLIENT_IMAGE, что и в .env.example.

LIVEKIT_API_URL=http://127.0.0.1:7880
LIVEKIT_WS_URL=ws://localhost:7880
LIVEKIT_API_KEY=kontur-local-key
LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters
LIVEKIT_USE_EXTERNAL_IP=false
# Use the full Compose profile for Egress/S3 recordings.
RECORDING_ENABLED=false
STT_API_URL=
STT_API_KEY=
STT_MODEL=whisper-1
STT_LANGUAGE=ru

WEB_PUSH_ENABLED=false
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.ru
INTEGRATION_ALLOWED_PRIVATE_HOSTS=

# Необязательные источники сборки Compose: docs/BUILD-SOURCES.md.
# Для npm на компьютере используйте npm ci --registry=АДРЕС отдельно.
# NPM_REGISTRY=https://registry.npmjs.org/
# ALPINE_MIRROR=https://dl-cdn.alpinelinux.org/alpine
# NODE_IMAGE=node:22-alpine
# NODEJS_DIST_URL=https://nodejs.org/dist
# GO_IMAGE=golang:1.24.13-bookworm
# DEBIAN_IMAGE=debian:bookworm-slim
# DEBIAN_MIRROR=http://deb.debian.org/debian
# DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
# GO_PROXY=https://proxy.golang.org,direct
# GO_SUMDB=sum.golang.org
# ARCHIVE_BASE=https://codeload.github.com
# HTTP_PROXY=http://proxy.company.ru:3128
# HTTPS_PROXY=http://proxy.company.ru:3128
# NO_PROXY=localhost,127.0.0.1,registry.company.ru,nexus.company.ru
# ALL_PROXY=
# Образы инфраструктуры наследуются из основного Compose.
# MYSQL_IMAGE=registry.company.ru/library/mysql:8.4
# POSTGRES_IMAGE=registry.company.ru/library/postgres:18-bookworm
# REDIS_IMAGE=registry.company.ru/library/redis:7.4-alpine
# LIVEKIT_IMAGE=registry.company.ru/livekit/livekit-server:v1.13.6
# GATEWAY_IMAGE=registry.company.ru/library/caddy:2.10-alpine
# BUILDKIT_SYNTAX=registry.company.ru/docker/dockerfile:1.7
