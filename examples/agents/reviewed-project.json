          "fields": []
        },
        {
          "id": "review",
          "name": "Проверка",
          "type": "analyze",
          "prompt": "Проверь выводы анализа по источникам. Отметь неподтверждённые выводы и недостающие данные.",
          "fields": []
        }
      ]
    },
    "actions": [],
    "mode": "review",
    "policy": {
      "require_citations": true,
      "min_confidence": 0.7
    }
  }
