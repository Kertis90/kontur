# Выбор БД для всей установки: mysql (по умолчанию) или postgres.
DB_ENGINE=mysql

# PostgreSQL 18: Compose запускается с дополнительным compose.postgres.yaml.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=kontur_work
POSTGRES_USER=kontur
POSTGRES_PASSWORD=replace-with-a-separate-strong-password
POSTGRES_ADMIN_PASSWORD=replace-with-another-postgres-admin-password
POSTGRES_POOL_SIZE=12
POSTGRES_CONNECT_TIMEOUT=10000
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
# POSTGRES_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=kontur_work
MYSQL_USER=kontur
MYSQL_PASSWORD=replace-with-strong-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-password
MYSQL_POOL_SIZE=12
MYSQL_CONNECT_TIMEOUT=10000

# Для внешнего managed MySQL можно включить TLS.
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true
# MYSQL_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Application security: generate with `openssl rand -base64 48`
AUTH_SECRET=replace-with-at-least-32-random-characters
APP_ENCRYPTION_KEY=replace-with-64-hex-characters
APP_URL=http://localhost:3000

# Очереди и файловые вложения
# По умолчанию MinIO собирается из закреплённых исходников; можно использовать свой реестр.
# MINIO_IMAGE=registry.company.ru/storage/minio:approved
# MINIO_CLIENT_IMAGE=registry.company.ru/storage/mc:approved
REDIS_URL=redis://redis:6379
# Параллельные запросы ИИ на один worker; endpoint и ключ задаются в интерфейсе.
AI_WORKER_CONCURRENCY=2

# Запись встречи включается вручную в интерфейсе. Для production закрепите образ Egress по digest.
RECORDING_ENABLED=true
LIVEKIT_EGRESS_IMAGE=livekit/egress:latest
RECORDING_WORKER_CONCURRENCY=1
RECORDING_TRANSCRIBE_MAX_GB=20
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=kontur-minio
S3_SECRET_KEY=replace-with-strong-minio-secret
S3_BUCKET=kontur-attachments
S3_FORCE_PATH_STYLE=true
MAX_ATTACHMENT_BYTES=26214400

# LiveKit SFU: отдельный медиасервер вместо P2P mesh. Секрет должен содержать не менее 32 символов.
LIVEKIT_API_KEY=kontur-production-key
LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters
LIVEKIT_WS_URL=ws://localhost:7880
LIVEKIT_USE_EXTERNAL_IP=false
# На публичном Linux-хосте включите true и разрешите TCP 7881, UDP 7882 и UDP 3478.
# При запуске профиля gateway задайте публичные DNS-имена; LIVEKIT_WS_URL должен быть wss://LIVEKIT_DOMAIN.
APP_DOMAIN=projects.example.ru
LIVEKIT_DOMAIN=media.example.ru

# OpenAI-compatible или локальный Whisper endpoint. Пустой URL отключает расшифровку.
STT_API_URL=
STT_API_KEY=
STT_MODEL=whisper-1
STT_LANGUAGE=ru
STT_TIMEOUT_MS=120000

# Provider-neutral телефонный шлюз. Пустой URL отключает исходящие звонки.
# Контракт шлюза и webhook описаны в docs/API.md.
TELEPHONY_API_URL=
TELEPHONY_API_TOKEN=
TELEPHONY_WEBHOOK_SECRET=
TELEPHONY_FROM_NUMBER=
TELEPHONY_TIMEOUT_MS=15000

# Bootstrap owner (created or restored by db:seed)
ADMIN_EMAIL=admin@example.ru
ADMIN_PASSWORD=replace-on-first-login
ADMIN_NAME=Администратор

# Миграции и начальные данные запускаются отдельным сервисом migrate.
# Чтобы использовать опубликованный образ вместо локальной сборки:
# KONTUR_IMAGE=registry.company.ru/platform/kontur-work:0.21.0

# ─── Зеркала источников сборки (для закрытого контура) ───────────────────────
# Все параметры необязательны: без них сборка идёт с публичных адресов.
# Базовые образы сборки задаются NODE_IMAGE / GO_IMAGE / DEBIAN_IMAGE.
# Используйте копии тех же версий и семейств Linux в своём реестре контейнеров.
# Готовые образы задаются KONTUR_IMAGE / MINIO_IMAGE / MINIO_CLIENT_IMAGE / LIVEKIT_EGRESS_IMAGE.
# Остальные сервисы и проверка восстановления также поддерживают свой реестр.
# MYSQL_IMAGE=registry.company.ru/library/mysql:8.4
# POSTGRES_IMAGE=registry.company.ru/library/postgres:18-bookworm
# REDIS_IMAGE=registry.company.ru/library/redis:7.4-alpine
# LIVEKIT_IMAGE=registry.company.ru/livekit/livekit-server:v1.13.6
# GATEWAY_IMAGE=registry.company.ru/library/caddy:2.10-alpine
# Обработчик Dockerfile хранилища; скопируйте docker/dockerfile:1.7 в свой реестр.
# BUILDKIT_SYNTAX=registry.company.ru/docker/dockerfile:1.7
# NODE_IMAGE=registry.company.ru/library/node:22-alpine
# GO_IMAGE=registry.company.ru/library/golang:1.24.13-bookworm
# DEBIAN_IMAGE=registry.company.ru/library/debian:bookworm-slim
# Заголовки Node.js для пакетов с нативными модулями; сам Node.js входит в NODE_IMAGE.
# NODEJS_DIST_URL=https://nexus.company.ru/repository/nodejs-dist
#
# Пакеты npm для образа приложения.
# NPM_REGISTRY=https://nexus.company.ru/repository/npm-proxy/
#
# Дополнительный HTTP/HTTPS-прокси для команд сборки (можно вместе с зеркалами).
# Передаётся как стандартный build argument, не сохраняется в окружении приложения.
# HTTP_PROXY=http://proxy.company.ru:3128
# HTTPS_PROXY=http://proxy.company.ru:3128
# NO_PROXY=localhost,127.0.0.1,registry.company.ru,nexus.company.ru
# ALL_PROXY=
#
# Пакеты Alpine (ffmpeg). Указывается базовый адрес: версия выпуска и разделы
# main/community подставляются из образа автоматически.
# ALPINE_MIRROR=https://nexus.company.ru/repository/alpine
#
# Пакеты Debian для сборки хранилища. Предпочтительно http: CA-сертификаты
# появляются в образе только после установки ca-certificates, поэтому зеркало
# по https с внутренним УЦ уронит apt. Целостность обеспечивают подписи GPG.
# DEBIAN_MIRROR=http://nexus.company.ru/repository/debian
# DEBIAN_SECURITY_MIRROR=http://nexus.company.ru/repository/debian-security
#
# Модули Go для сборки MinIO и mc. Модули дополнительно проверяются по go.sum из
# самих исходников, поэтому GO_SUMDB=off допустим, если прокси не отдаёт sum.golang.org.
# GO_PROXY=https://nexus.company.ru/repository/go-proxy,direct
# GO_SUMDB=off
#
# Исходники MinIO и mc с GitHub. ARCHIVE_BASE подходит для прозрачного raw-прокси,
# сохраняющего пути вида /minio/minio/tar.gz/<коммит>.
# ARCHIVE_BASE=https://nexus.company.ru/repository/codeload-proxy
#
# Если архивы выложены на внутреннем файловом хранилище под своими именами,
# задайте адреса целиком. SHA-256 относится к содержимому архива: копируйте файлы
# побайтно. Пересобранный другим сервисом архив тех же коммитов даст другую сумму —
# тогда проверьте его вручную и обновите контрольные суммы.
# MINIO_SOURCE_URL=https://nexus.company.ru/repository/raw/minio-07c3a429.tar.gz
# MC_SOURCE_URL=https://nexus.company.ru/repository/raw/mc-7394ce0d.tar.gz
# MINIO_SOURCE_SHA256=sha256:...
# MC_SOURCE_SHA256=sha256:...

# 0 — хранить новые записи без ограничения; срок можно изменить в интерфейсе.
RECORDING_RETENTION_DAYS=0

# Точные имена внутренних HTTPS-сервисов для новых интеграций (через запятую).
# Разрешает RFC1918/ULA; localhost и metadata остаются запрещены.
INTEGRATION_ALLOWED_PRIVATE_HOSTS=

# Optional encrypted MySQL backups. Keep this key separately from the application key.
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_BUCKET=
# Optional dedicated restore drill (not production).
RESTORE_MYSQL_USER=root
RESTORE_MYSQL_PASSWORD=
RESTORE_MYSQL_DATABASE=kontur_restore_drill

# Browser push (HTTPS and worker required). Generate once: npm run push:keys
WEB_PUSH_ENABLED=false
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.ru
